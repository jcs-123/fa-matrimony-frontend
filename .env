# true  = use the built-in mock API (sample data saved in the browser) – no backend needed
# false = call the real backend at VITE_API_BASE_URL
VITE_USE_MOCK=false

# Base URL of the backend REST API (see API.md). Example: https://api.familyapostolatetsr.org/api  or  /api (with the dev proxy)
VITE_API_BASE_URL=/api
# Proxy target for local development (points to your local Node.js backend)
# API_PROXY_TARGET=http://127.0.0.1:4018
API_PROXY_TARGET=https://newfab.trichurfamilyapostolate.org
